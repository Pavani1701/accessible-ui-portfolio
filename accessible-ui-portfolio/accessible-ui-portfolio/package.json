{
  "name": "accessible-ui-portfolio",
  "version": "1.0.0",
  "description": "Accessible (WCAG 2.1 AA / Section 508) design system and multi-step application form built with HTML5, Sass and vanilla JavaScript.",
  "private": true,
  "scripts": {
    "build:css": "sass src/scss/main.scss site/css/main.css --no-source-map --style=expanded",
    "watch:css": "sass src/scss/main.scss site/css/main.css --watch",
    "start": "http-server site -p 4173 -c-1",
    "test": "playwright test",
    "test:a11y": "playwright test tests/a11y.spec.js"
  },
  "keywords": ["accessibility", "wcag", "section-508", "sass", "design-system", "aria"],
  "author": "Pavani Madhyannapu",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.63.0",
    "http-server": "^14.1.1",
    "sass": "^1.80.0"
  }
}
